rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }
    
    function isValidUserProgress(data) {
      return data.keys().hasAll(['ownerId', 'trackerData']) 
        && data.ownerId == request.auth.uid
        && data.trackerData is string
        && data.trackerData.size() <= 1048576;
    }

    match /users/{userId} {
      allow read: if isSignedIn() && isValidId(userId) && userId == request.auth.uid;
      
      allow create: if isSignedIn() 
        && isValidId(userId)
        && userId == request.auth.uid
        && isValidUserProgress(incoming());

      allow update: if isSignedIn()
        && isValidId(userId)
        && userId == request.auth.uid
        && existing().ownerId == request.auth.uid
        && incoming().ownerId == existing().ownerId
        && isValidUserProgress(incoming())
        && incoming().diff(existing()).affectedKeys().hasOnly(['trackerData', 'updatedAt', 'college', 'hscYear', 'name', 'mobile', 'group']);
        
      allow delete: if false;
    }
  }
}
