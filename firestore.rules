rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Primitive Helpers
    function isSignedIn() { return request.auth != null; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }

    // Validation Helpers
    function isValidUserMap() {
      let ownerIdValid = incoming().keys().hasAny(['ownerId']) ? (incoming().ownerId is string && incoming().ownerId == request.auth.uid) : true;
      let trackerDataValid = incoming().keys().hasAny(['trackerData']) ? incoming().trackerData is string : true;
      let updatedAtValid = incoming().keys().hasAny(['updatedAt']) ? incoming().updatedAt is string : true;
      
      return ownerIdValid && trackerDataValid && updatedAtValid;
    }

    match /users/{userId} {
      // Only the owner can read their own document
      allow get: if isSignedIn() && request.auth.uid == userId;
      // No listing allowed to prevent scraping
      allow list: if false;
      
      // Allow create and update if user matches ID and sends valid data
      allow create: if isSignedIn() && request.auth.uid == userId && isValidId(userId) && isValidUserMap();
      
      allow update: if isSignedIn() && 
                       request.auth.uid == userId && 
                       isValidId(userId) && 
                       isValidUserMap() && 
                       // Protect ownerId from being modified after creation
                       (incoming().keys().hasAny(['ownerId']) ? incoming().ownerId == existing().ownerId : true);
                       
      allow delete: if false;
    }
  }
}
